# 本机 prod.local：Vite（build:prod-local）与 start.sh / stop.sh 共用

VITE_BUILD_ENV=prod
VITE_APP_ID=TimetableCraft-WEB-Prod-Local
VITE_PORT=10401
VITE_SITE_URL=http://192.168.1.64:10401

NAS_IP=192.168.1.64
TIMETABLECRAFT_WEB_IMAGE=timetablecraft-web:prod-local
TIMETABLECRAFT_WEB_CONTAINER=TimetableCraft-WEB-Prod-Local
TIMETABLECRAFT_WEB_PORT=10401
TIMETABLECRAFT_WEB_RESTART=always
